<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop6 rescap">

  <!-- Publisher must exactly match the signing certificate Subject at packaging time.
       For dev-mode loose registration (Add-AppxPackage -Register) any value works. -->
  <Identity
    Name="AmazonMusicSmtc"
    Publisher="CN=AmazonMusicSmtc.Dev"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- Deliberately spelled "AmazonMusic" without a space: tools that filter media
         sessions by app-name substring (e.g. FluentFlyout's app filtering) would
         otherwise match a "Amazon Music" block rule against this bridge as well.
         This DisplayName is what shell:AppsFolder reports for our AUMID. -->
    <DisplayName>AmazonMusic SMTC Bridge</DisplayName>
    <PublisherDisplayName>AmazonMusicSmtc</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>

    <!-- Without this, MSIX redirects the app's HKCU writes into a per-package hive
         that only this app can see. NotificationBannerSuppressor writes a per-app
         notification setting the shell has to read, so the redirection has to be
         off. Honoured from Windows 10 1903; older builds ignore it (desktop6 is in
         IgnorableNamespaces) and the suppressor declines to write there.
         The bridge writes exactly one HKCU value, so a package-wide opt-out costs
         nothing over the narrower virtualization:ExcludedKeys form, which would
         raise the floor to build 20348. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by desktop6:RegistryWriteVirtualization above. Restricted, but so
         is runFullTrust: this package is sideloaded, never Store-submitted. -->
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- The reason this app must be packaged at all: this capability cannot be
         declared without package identity. -->
    <uap3:Capability Name="userNotificationListener" />
    <!-- Cover art is fetched from Amazon's public image CDN. Loopback to the
         CEF debug port needs no capability: runFullTrust keeps the process out
         of an AppContainer, so network isolation does not apply. -->
    <Capability Name="internetClient" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="AmazonMusicSmtc.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AmazonMusic SMTC Bridge"
        Description="Publishes complete SMTC metadata for Amazon Music"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Declarative auto-start; the user can toggle it in Settings > Apps > Startup. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="AmazonMusicSmtc.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="AmazonMusicSmtcStartup"
            Enabled="true"
            DisplayName="AmazonMusic SMTC Bridge" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

</Package>
